{
    "name": "amazeeio/laravel-amazee-ai-provider",
    "description": "amazee.ai provider for the Laravel AI SDK.",
    "license": "MIT",
    "keywords": [
        "laravel",
        "ai",
        "amazee.ai",
        "litellm"
    ],
    "homepage": "https://github.com/amazeeio/laravel-amazee-ai-provider",
    "require": {
        "php": "^8.3",
        "laravel/ai": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.6|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Amazee\\LaravelAi\\": "src/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Amazee\\LaravelAi\\AmazeeAiServiceProvider"
            ]
        }
    }
}
